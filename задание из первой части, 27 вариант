/* коэффицент "a" дроби по номеру k,
 сначала думал делать через массив, но тут закономерность проще
 a(0)=2, дальше блоки по 3: 1, чётное, 1
 то есть 1,2,1, 1,4,1, 1,6,1 и т.д.*/

double a(int k)
{
    if (k == 0)
        return 2.0;                     // самый первый a(0)
    if (k % 3 == 2)                     // каждое третье начиная со 2-го  чётное
        return 2.0 * ((k + 1.0) / 3.0); // 2, 4, 6, 8...
    return 1.0;                         // остальные будут единицам
}




// считает дробь глубины n
// по сути берет глубину заданную в аргументе и смотрит что дробь выдаст, поднимаясь снизу вверх
// то есть начинаем с a(n) и поднимаемся до a(0)
double calcdeth(int n)
{
    double x = a(n);        // нижний коэффициент
    int i = n - 1;          // идём на уровень выше
    while (i >= 0)
    {
        x = a(i) + 1.0 / x; // добавляем промежуточную дробь
        i -= 1;             // снова на уровень выше
    }
    return x;
}

void mainDoWhile(double tochnost)
{
    int n = 1;                              // начинаем с глубины 1
    double proshloe = calcdeth(0);          // глубина 0
    double nastoyash = calcdeth(1);         // глубина 1

    // fabs это модуль, чтобы разница была положительной
    do
    {
        proshloe = nastoyash;               // сдвигаем
        n += 1;                             // глубину увеличиваем
        nastoyash = calcdeth(n);            // считаем новое
    } while (fabs(nastoyash - proshloe) >= tochnost);

    // err вывожу для себя, чтобы видеть реальную точность
    cout << "do while:    e(моя) = " << nastoyash
        << ", необходимая глубина для данной точности = " << n
        << ", разница с е(настоящ) = " << fabs(nastoyash - exp(1.0)) << endl;
}







void mainFor(double tochnost)
{
    int n = 1;                              // начинаем с глубины 1
    double proshloe = calcdeth(0);          // глубина 0
    double nastoyash = calcdeth(1);         // глубина 1

    for (n = 2; fabs(nastoyash - proshloe) >= tochnost; n++) {
        proshloe = nastoyash;
        nastoyash = calcdeth(n);
    }
    // err вывожу для себя, чтобы видеть реальную точность
    cout << "for:    e(моя) = " << nastoyash
        << ", необходимая глубина для данной точности = " << n-1 // -1, потому что цикл прогоняет +1, хоть условие и стопает
        << ", разница с е(настоящ) = " << fabs(nastoyash - exp(1.0)) << endl;
    
}
// основная логика: увеличиваем глубину, пока результат не приблизиться к е
// сравниваем два соседних приближения (глубина n-1 и n)
// если разница меньше точности( < tochnoct), то стоп
// из условия лабы точность( tochnoct ) = 1e-2, 1e-4, 1e-6, 1e-8
void mainWhile(double tochnoct)
{
    int n = 1;                              // начинаем с глубины 1
    double proshloe = calcdeth(0);          // глубина 0
    double nastoyash = calcdeth(1);         // глубина 1

    // fabs это модуль, чтобы разница была положительной
    while (fabs(nastoyash - proshloe) >= tochnoct)
    {
        proshloe = nastoyash;               // сдвигаем
        n += 1;                             // глубину увеличиваем
        nastoyash = calcdeth(n);            // считаем новое
    }

    // err вывожу для себя, чтобы видеть реальную точность
    cout << "while:    e(моя) = " << nastoyash
        << ", необходимая глубина для данной точности = " << n
        << ", разница с е(настоящ) = " << fabs(nastoyash - exp(1.0)) << endl;
}

